# STARCORE Platform - environment configuration template
# Copy to .env and fill in real values. .env is gitignored.

STARCORE_API_HOST=0.0.0.0
STARCORE_API_PORT=8000
STARCORE_DEBUG=false

# Only required if you opt into the optional Postgres scaffold service via
# `docker compose --profile scaffold up` (not started by default).
STARCORE_POSTGRES_PASSWORD=change-me-to-a-random-secret

# Proxmox API token (Datacenter -> Permissions -> API Tokens)
STARCORE_PROXMOX_HOST=
STARCORE_PROXMOX_USER=
STARCORE_PROXMOX_TOKEN_NAME=
STARCORE_PROXMOX_TOKEN_VALUE=
STARCORE_PROXMOX_VERIFY_SSL=true

# Shared secret required in the X-API-Key header for protected endpoints.
# API is closed by default (503) until this is set.
STARCORE_API_KEY=change-me-to-a-random-secret

# Requests per minute allowed per client IP across the whole API (except
# /health, which is never rate-limited). Set to 0 to disable.
STARCORE_RATE_LIMIT_PER_MINUTE=60

# Log format: false (default) = human-readable text; true = one JSON object
# per line, suited for log aggregators such as Loki, ELK, or CloudWatch.
STARCORE_LOG_JSON=false

# AI-assisted blueprint generation (starcore ai generate / POST /ai/generate-blueprint)
#
# Provider selection: "anthropic" (default) or "openai-compatible"
# (works with Ollama, LM Studio, vLLM, LocalAI, or any /v1/chat/completions server).
STARCORE_AI_PROVIDER=anthropic

# --- Anthropic provider (ai_provider = anthropic) ---
STARCORE_ANTHROPIC_API_KEY=
STARCORE_ANTHROPIC_MODEL=claude-sonnet-5

# --- OpenAI-compatible provider (ai_provider = openai-compatible) ---
# Base URL of the /v1/chat/completions endpoint (trailing /v1 is required).
# Examples:
#   Ollama local:  http://localhost:11434/v1
#   LM Studio:     http://localhost:1234/v1
#   OpenAI:        https://api.openai.com/v1
STARCORE_AI_BASE_URL=
# API key — required for OpenAI and many hosted endpoints; leave empty for Ollama/LM Studio.
STARCORE_AI_API_KEY=
# Model name as known to the server above — required, no default (e.g. "llama3" for
# Ollama, "gpt-4o-mini" for OpenAI). STARCORE_ANTHROPIC_MODEL is NOT used here.
STARCORE_AI_MODEL=
