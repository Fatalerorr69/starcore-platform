{
  "// ============================================================================": "",
  "// PYTHON DEVELOPMENT SETTINGS FOR STARCORE PLATFORM": "",
  "// ============================================================================": "",
  
  "python.defaultInterpreterPath": "${workspaceFolder}/.venv/bin/python",
  "python.linting.enabled": true,
  "python.linting.pylintEnabled": false,
  "python.linting.flake8Enabled": false,
  "python.linting.mypyEnabled": false,
  
  "[python]": {
    "editor.formatOnSave": true,
    "editor.formatOnPaste": true,
    "editor.defaultFormatter": "charliermarsh.ruff",
    "editor.codeActionsOnSave": {
      "source.organizeImports.ruff": "explicit",
      "source.fixAll.ruff": "explicit"
    }
  },
  
  "ruff.path": [
    "${workspaceFolder}/.venv/bin/ruff"
  ],
  "ruff.importStrategy": "fromEnvironment",
  "ruff.serverEnvironmentPath": "${workspaceFolder}/.venv",
  
  "[yaml]": {
    "editor.formatOnSave": false,
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  
  "[json]": {
    "editor.formatOnSave": true,
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  
  "// ============================================================================": "",
  "// GITHUB COPILOT CONFIGURATION": "",
  "// ============================================================================": "",
  
  "github.copilot.enable": {
    "markdown": true,
    "plaintext": true,
    "yaml": true,
    "json": true,
    "python": true
  },
  
  "github.copilot.advanced": {
    "inlineSuggestCount": 3,
    "listCount": 10,
    "debug.overrideEngine": "",
    "debug.testOverrideProxyUrl": "",
    "debug.mockCompletionsFailing": false,
    "debug.overrideProxyUrl": ""
  },
  
  "// ============================================================================": "",
  "// PYRIGHT TYPE CHECKING": "",
  "// ============================================================================": "",
  
  "pylance.typeCheckingMode": "strict",
  "python.analysis.typeCheckingMode": "strict",
  "python.analysis.include": [
    "packages",
    "apps",
    "tests",
    "scripts"
  ],
  "python.analysis.diagnosticSeverityOverrides": {
    "reportUnusedVariable": "warning",
    "reportUnusedImport": "error",
    "reportGeneralTypeIssues": "error",
    "reportOptionalMemberAccess": "error",
    "reportOptionalSubscript": "error"
  },
  
  "// ============================================================================": "",
  "// TESTING CONFIGURATION": "",
  "// ============================================================================": "",
  
  "python.testing.pytestEnabled": true,
  "python.testing.pytestArgs": [
    "tests",
    "-v",
    "--tb=short"
  ],
  "python.testing.unittestEnabled": false,
  
  "// ============================================================================": "",
  "// EDITOR PREFERENCES": "",
  "// ============================================================================": "",
  
  "editor.rulers": [88, 120],
  "editor.formatOnSaveTimeout": 10000,
  "editor.codeLens": true,
  "editor.inlayHints.enabled": "offUnlessPressed",
  "editor.defaultFormatter": "charliermarsh.ruff",
  
  "files.exclude": {
    "**/__pycache__": true,
    "**/*.pyc": true,
    "**/.pytest_cache": true,
    "**/.mypy_cache": true,
    "**/.ruff_cache": true,
    "**/node_modules": true,
    "**/.venv": true
  },
  
  "files.associations": {
    "*.yaml": "yaml",
    "*.yml": "yaml",
    "Dockerfile": "dockerfile"
  },
  
  "// ============================================================================": "",
  "// RECOMMENDED EXTENSIONS": "",
  "// ============================================================================": "",
  "// Run: code --install-extension github.copilot": "",
  "// Run: code --install-extension charliermarsh.ruff": "",
  "// Run: code --install-extension ms-python.python": "",
  "// Run: code --install-extension ms-python.vscode-pylance": "",
  "cursorpyright.analysis.diagnosticSeverityOverrides": {
    "reportUnusedVariable": "warning",
    "reportUnusedImport": "error",
    "reportGeneralTypeIssues": "error",
    "reportOptionalMemberAccess": "error",
    "reportOptionalSubscript": "error"
  },
  "cursorpyright.analysis.include": [
    "packages",
    "apps",
    "tests",
    "scripts"
  ],
  "cursorpyright.analysis.typeCheckingMode": "basic"
}
