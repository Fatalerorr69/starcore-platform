{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "STARCORE API (Debug)",
      "type": "python",
      "request": "launch",
      "module": "uvicorn",
      "args": [
        "core.main:app",
        "--reload",
        "--port",
        "8000"
      ],
      "jinja": true,
      "justMyCode": true,
      "env": {
        "STARCORE_LOG_JSON": "false",
        "STARCORE_API_KEY": "test-key-debug"
      },
      "console": "integratedTerminal"
    },
    {
      "name": "STARCORE CLI",
      "type": "python",
      "request": "launch",
      "module": "apps.cli.main",
      "args": [
        "blueprint",
        "plan",
        "packages/blueprints/examples/basic.yaml"
      ],
      "console": "integratedTerminal"
    },
    {
      "name": "Pytest (Current File)",
      "type": "python",
      "request": "launch",
      "module": "pytest",
      "args": [
        "${file}",
        "-v",
        "--tb=short"
      ],
      "justMyCode": false,
      "console": "integratedTerminal"
    }
  ]
}
